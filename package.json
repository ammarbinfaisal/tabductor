{
  "name": "tabductor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm -F web typecheck",
    "build:web": "pnpm -F web build",
    "dev:web": "pnpm -F web dev",
    "lint": "eslint packages apps/engine && pnpm -F web lint",
    "test": "vitest run",
    "test:system": "vitest run --project system",
    "dev:engine": "tsx watch apps/engine/src/main.ts"
  },
  "devDependencies": {
    "@tabductor/browser": "workspace:*",
    "@tabductor/bus": "workspace:*",
    "@tabductor/core": "workspace:*",
    "@tabductor/db": "workspace:*",
    "@tabductor/engine": "workspace:*",
    "@tabductor/policy": "workspace:*",
    "@tabductor/telemetry": "workspace:*",
    "@tabductor/testkit": "workspace:*",
    "@trpc/server": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.17.1",
    "drizzle-orm": "^0.44.0",
    "eslint": "^9.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
