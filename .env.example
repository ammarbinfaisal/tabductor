# Copy to `.env` (Compose reads it automatically). Clerk keys are required for sign-in
# with the production web image. Provider keys below enable their respective capabilities.

# Use the publishable and secret keys from the same Clerk development instance locally.
# After changing them, recreate web: docker compose up -d --no-deps web
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# LLM provider for the (browser|asset|decision, ai) executors and publish-time schema
# compilation. Anthropic wins when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Admin access: comma-separated internal account IDs (shown on /billing).
# Comma-separated internal acct_ IDs or Clerk user_ IDs allowed to use /admin.
ADMIN_ACCOUNT_IDS=
# USD value of ONE legacy credit. Wallets convert automatically; defaults to 1.
# Agreed conversion: one old credit equals $1.00 USD.
LEGACY_CREDIT_USD=1

# Platform-funded browser action descriptions (also used for BYO-model accounts).
ACTION_SUMMARY_MODEL=gpt-5.4-nano

# Set rates in Admin → Pricing & costs; these optional USD defaults are fallbacks.
BROWSER_USD_PER_MINUTE=
BROWSER_RATE_VERSION=usd-v1
# Model token rates are USD per million tokens. Provider cost is configured in Admin.
# [{"provider":"openai","model":"gpt-5.4-nano","version":"usd-v1","inputUsd":"0.20","cachedInputUsd":"0.02","outputUsd":"1.25","maxInputTokens":400000,"maxOutputTokens":16384}]
MODEL_USD_RATES_JSON=
CAPSOLVER_API_KEY=
TWO_CAPTCHA_API_KEY=
ANTI_CAPTCHA_API_KEY=
# [{"name":"2captcha","rateVersion":"usd-v1","priceUsd":"0.10"}]
# Per-native-task Admin rates take precedence over provider defaults.
SOLVER_USD_RATES_JSON=

# Paddle USD prepaid balance packs. See docs/usd-administration.md for setup.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
# [{"priceId":"pri_...","balanceUsd":"10.00"}]
PADDLE_USD_PACKS_JSON=

# IPRoyal Residential usage imports; map existing hashes in Admin → Providers.
IPROYAL_API_TOKEN=

# Domains browser nodes may navigate to (suffix match, subdomains included). Empty — the
# default — allows all: leave it alone unless you want to confine the browser, in which case
# list every domain your workflows actually reach, redirects and asset hosts included.
# Example for the daily-expenditure flow:
#   HARNESS_NAV_ALLOWLIST=mail.google.com,accounts.google.com,google.com,localhost,127.0.0.1
HARNESS_NAV_ALLOWLIST=

# Optional overrides
# Local runs show actual tool-call parameters. Set 0 to disable development diagnostics.
#TABDUCTOR_DEV_MODE=1
#SCHEMA_MODEL=
#OTEL_EXPORTER_OTLP_ENDPOINT=
#LOG_LEVEL=info

# Interface the published ports bind to (postgres 5434, minio 9002, web 3000, and the
# telemetry profile's 3001/4317/4318). Loopback by default; 0.0.0.0 exposes them to the LAN.
# The datastore credentials are trivial by design, so anything that can route to them can
# read and write — opt in deliberately.
#BIND_ADDR=0.0.0.0
