# Copy to `.env` (compose reads it automatically). Everything here is optional — the app
# boots without any of it, but the corresponding capability is withheld and says so at boot.

# LLM provider for the (browser|asset|decision, ai) executors and publish-time schema
# compilation. Anthropic wins when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Domains browser nodes may navigate to (suffix match, subdomains included). Empty — the
# default — allows all: leave it alone unless you want to confine the browser, in which case
# list every domain your workflows actually reach, redirects and asset hosts included.
# Example for the daily-expenditure flow:
#   HARNESS_NAV_ALLOWLIST=mail.google.com,accounts.google.com,google.com,localhost,127.0.0.1
HARNESS_NAV_ALLOWLIST=

# Optional overrides
#SCHEMA_MODEL=
#OTEL_EXPORTER_OTLP_ENDPOINT=
#LOG_LEVEL=info

# Interface the published ports bind to (postgres 5434, minio 9002, web 3000, and the
# telemetry profile's 3001/4317/4318). Loopback by default; 0.0.0.0 exposes them to the LAN.
# The datastore credentials are trivial by design, so anything that can route to them can
# read and write — opt in deliberately.
#BIND_ADDR=0.0.0.0
