# Copy to `.env` (Compose reads it automatically). Clerk keys are required for sign-in
# with the production web image. Provider keys below enable their respective capabilities.

# Use the publishable and secret keys from the same Clerk development instance locally.
# After changing them, recreate web: docker compose up -d --no-deps web
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# LLM provider for the (browser|asset|decision, ai) executors and publish-time schema
# compilation. Anthropic wins when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# CAPTCHA providers (engine only). Keys also need a matching SOLVER_RATES_JSON
# entry before the engine enables a provider. creditUnits is your internal
# charge per solve, not the provider's dollar price; configure it explicitly.
CAPSOLVER_API_KEY=
TWO_CAPTCHA_API_KEY=
ANTI_CAPTCHA_API_KEY=
# Example: [{"name":"capsolver","rateVersion":"solver-v1","creditUnits":1},{"name":"2captcha","rateVersion":"solver-v1","creditUnits":1}]
# Valid provider names: capsolver, 2captcha, anti-captcha.
SOLVER_RATES_JSON=

# Domains browser nodes may navigate to (suffix match, subdomains included). Empty — the
# default — allows all: leave it alone unless you want to confine the browser, in which case
# list every domain your workflows actually reach, redirects and asset hosts included.
# Example for the daily-expenditure flow:
#   HARNESS_NAV_ALLOWLIST=mail.google.com,accounts.google.com,google.com,localhost,127.0.0.1
HARNESS_NAV_ALLOWLIST=

# Optional overrides
# Local runs show actual tool-call parameters. Set 0 to disable development diagnostics.
#TABDUCTOR_DEV_MODE=1
#SCHEMA_MODEL=
#OTEL_EXPORTER_OTLP_ENDPOINT=
#LOG_LEVEL=info

# Interface the published ports bind to (postgres 5434, minio 9002, web 3000, and the
# telemetry profile's 3001/4317/4318). Loopback by default; 0.0.0.0 exposes them to the LAN.
# The datastore credentials are trivial by design, so anything that can route to them can
# read and write — opt in deliberately.
#BIND_ADDR=0.0.0.0
