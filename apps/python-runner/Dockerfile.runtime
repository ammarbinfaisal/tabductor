FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY vendor/browser-harness/src/browser_harness /opt/browser_harness
COPY packages/agent/python/runner.py /opt/tabductor_runner.py
RUN useradd --uid 10001 --create-home agent
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["python", "-I", "/opt/tabductor_runner.py", "--supervise"]
